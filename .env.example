# Digiswasthya website - environment variables (names and safe placeholders only).
#
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# Variables that start with NEXT_PUBLIC_ are visible in the browser - never put secrets in them.
# Variables marked "optional" can be left out.

# --- Website: Firebase web app (browser; Our Impact data is read from Firestore) ---
# Firebase Console > Project settings > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Website: general ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PIN for the /admin media page
ADMIN_PIN=your-admin-pin
# Shared secret for protected server routes (/api/cron/*, /api/scraper/run)
CRON_SECRET=your-random-secret

# --- Website: Firebase Admin (server-side; media routes). JSON text of a service account, or leave empty ---
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Website: payments (Razorpay) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# --- Website: email ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
SMTP_EMAIL=your-smtp-email@example.com
SMTP_PASSWORD=your-smtp-app-password
INQUIRY_EMAIL=inquiries@example.com
DOCTOR_ONBOARDER_EMAIL=doctors@example.com
DONOR_INFO_EMAIL=donors@example.com

# --- Website: AI chat and video summary ---
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- Data pipeline (src/scripts/agents/*.py) ---
# NOTE: the Python scripts read these from a file named `.env` in the folder they are run from,
# or from the process environment. See the project README.
# Management Portal login (use placeholders like these only in this example file)
MANAGEMENT_PORTAL_URL=https://portal.example.com
MANAGEMENT_PORTAL_EMAIL=your-email@example.com
MANAGEMENT_PORTAL_PASSWORD=your-secure-password
# Legacy names still read by the scripts and /api/scraper/run (optional)
DIGISWASTHYA_PORTAL_URL=
DIGISWASTHYA_PORTAL_USER=
DIGISWASTHYA_PORTAL_PASS=
# Firebase safety check: the only project the pipeline may write to (currently the test project)
FIREBASE_EXPECTED_PROJECT_ID=digiswasthya-pipeline-test
# Path to a service-account key file kept OUTSIDE the project folder (never commit it)
GOOGLE_APPLICATION_CREDENTIALS=
# Google Sheet to update (optional; Sheets sync is skipped without a key file)
GOOGLE_SHEET_ID=
