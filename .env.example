# Environment variables - placeholders only. Copy the variables you need into `.env.local` and fill in real values.
# Never commit `.env.local`, and never put real values in this file.

# --- Our Team page: Google Sheets + Google Drive (server-side only) ---
# Read by src/lib/teamDirectory.ts. None of these may ever start with NEXT_PUBLIC_ (that would send them to visitors' browsers).

# The Google service-account key: the whole JSON file as ONE line. This is a secret.
GOOGLE_TEAM_SERVICE_ACCOUNT_KEY=your-service-account-json-on-one-line

# The Google Sheet that lists the team (the long ID in the Sheet's address: .../d/<THIS-PART>/edit)
GOOGLE_TEAM_SHEET_ID=your-google-sheet-id

# The Google Drive parent folder that contains the "Photos" folder (the ID at the end of the folder's address)
GOOGLE_TEAM_DRIVE_FOLDER_ID=your-drive-folder-id

# Optional: the name of the Sheet tab to read. Leave empty to use the first tab.
GOOGLE_TEAM_SHEET_TAB=

# --- Our Team page: automatic updates from Google Sheets (server-side only) ---
# Read by src/app/api/team-refresh/route.ts. The Google Apps Script in docs/team-apps-script/ sends this value to tell the
# website that the Sheet changed. Use a long random value of at least 24 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If it is missing or shorter than 24 characters, the endpoint rejects every request. Never use NEXT_PUBLIC_ for it.
TEAM_REFRESH_SECRET=your-long-random-secret
